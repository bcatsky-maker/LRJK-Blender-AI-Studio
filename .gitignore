# =====================================================================
# LRJK Blender AI Studio - .gitignore
#
# Added because the repo had no .gitignore at all: build_all.py's
# auto-sync step (and the GitHub Actions release workflow, which also
# runs build_all.py) were blindly `git add .`-ing the entire working
# tree, which meant build/, dist/, Release_Installers/ and the
# multi-gigabyte studio_memory.db were all getting committed and
# pushed. See build_all.py for the accompanying fix (push is now
# opt-in and no longer stages the whole tree unconditionally).
# =====================================================================

# --- The runtime asset/knowledge database. This is user-local data
# and (pre-migration) can be many GB - it must never be committed. ---
studio_memory.db
studio_memory.db-wal
studio_memory.db-shm
*.db-journal

# --- Ingested asset library: the actual files (can be tens of GB) and
# the portable seed catalog generated at build time. Bundled into the
# installer by build_all.py / installer_setup.iss, never into git. ---
asset_store/
seed_library.db

# --- Build & packaging output (regenerated by build_all.py) ---
/build/
/dist/
/installer_output/
/Release_Installers/
*.spec

# --- Update feed + change-detection state (produced by build_update.py) ---
# The 'updates/' folder holds built update installers + latest_update.json;
# you HOST its contents, you don't commit them. .update_state.json is the
# local "last built app fingerprint" and is machine-specific.
/updates/
.update_state.json

# --- Cython compiled artifacts (regenerated at build time) ---
src/core/generator.c
src/core/*.pyd
src/core/*.so
src/core/*.py.bak

# --- Python ---
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# --- Raw downloaded asset staging folders (large, re-fetchable) ---
assets/blender_extensions/
assets/freesound/
assets/makehuman/
assets/polyhaven/
assets/sketchfab/
assets/sound_effects/
assets/runtime_cache/

# --- Absorbed third-party add-ons ingested at runtime ---
src/core/absorbed_addons/

# --- Local maintenance / scratch ---
_to_delete/

# --- Editor / OS cruft ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Local secrets / env files, if you add any later ---
.env
*.local
