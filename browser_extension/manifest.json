{
  "manifest_version": 3,
  "name": "LRJK AI Studio - Model Grabber",
  "version": "1.1.0",
  "description": "Sends model links, BlendKit IDs, and web references directly to LRJK Blender AI Studio.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LRJK Model Grabber",
    "default_popup": "options.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
